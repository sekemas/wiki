# The one credential Openpedia needs. Copy the value into your shell, do not
# create a .env file: a .env in this directory would shadow the platform's own
# DATABASE_URL on the deployed site, and the deployed site must win.
#
#   export DATABASE_URL="postgresql://openpedia:openpedia@localhost:5432/openpedia?schema=public"
#
# `docker compose up -d` (see docker-compose.yml) serves exactly this URL.
DATABASE_URL="postgresql://openpedia:openpedia@localhost:5432/openpedia?schema=public"
